# PC-28 backend read by WEB-PC server.js/scraper.js.
# PC-28 backend itself reads pc28.ai/ajax.php and exposes /api/ai-signal.
PC28_BACKEND_BASE_URL="https://api.startpops.xyz"

# Optional full upstream endpoint override for WEB-PC server.js/scraper.js.
# PC28_SIGNAL_URL="https://api.startpops.xyz/api/ai-signal"

# Frontend defaults to same-origin /api/ai-signal so it can use WEB-PC fallback.
# Only set this if you deliberately want the browser to bypass WEB-PC proxy.
# VITE_PC28_API_URL="https://api.startpops.xyz/api/ai-signal"

# Local PC-28 backend example:
# PC28_BACKEND_BASE_URL="http://localhost:3000"

# Disable local history fallback and return 502 when the upstream is unavailable.
# PC28_DISABLE_HISTORY_FALLBACK="true"

# Optional local JSONL fallback source.
# PC28_HISTORY_PATH="data/history.jsonl"
